# ==========================================================================
#  MODELE du fichier .env (les secrets). A copier :  cp .env.exemple .env
#  puis remplir avec nano et protéger :              chmod 600 .env
#  Le vrai .env n'est JAMAIS publié (voir .gitignore).
# ==========================================================================

# Proton VPN : clé privée WireGuard (account.protonvpn.com > Téléchargements
# > WireGuard, avec "NAT-PMP (Port Forwarding)" coché). Ligne PrivateKey = ...
WIREGUARD_PRIVATE_KEY=

# DuckDNS : token SECRET (duckdns.org) + sous-domaines SANS ".duckdns.org"
DUCKDNS_TOKEN=
JELLYFIN_SUB=
NAVIDROME_SUB=
